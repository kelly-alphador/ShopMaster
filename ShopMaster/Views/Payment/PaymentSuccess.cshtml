@{
    ViewData["Title"] = "Paiement réussi";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <!-- Message de succès principal -->
            <div class="card border-success shadow-lg">
                <div class="card-header bg-success text-white text-center">
                    <h3 class="mb-0">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        Paiement réussi !
                    </h3>
                </div>
                <div class="card-body text-center py-5">
                    <div class="mb-4">
                        <i class="bi bi-check-circle text-success" style="font-size: 4rem;"></i>
                    </div>

                    <h4 class="text-success mb-3">Merci pour votre commande !</h4>
                    <p class="lead text-muted mb-4">
                        Votre paiement a été traité avec succès. Vous recevrez bientôt un email de confirmation.
                    </p>

                    <!-- Détails de la transaction -->
                    <div class="card bg-light border-0 mb-4">
                        <div class="card-body">
                            <h6 class="card-title text-primary">
                                <i class="bi bi-receipt me-2"></i>Détails de la transaction
                            </h6>
                            <div class="row text-start">
                                @if (!string.IsNullOrEmpty(ViewBag.PaymentId))
                                {
                                    <div class="col-sm-6 mb-2">
                                        <small class="text-muted">ID de paiement :</small><br>
                                        <strong>@ViewBag.PaymentId</strong>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(ViewBag.TransactionId))
                                {
                                    <div class="col-sm-6 mb-2">
                                        <small class="text-muted">ID de transaction :</small><br>
                                        <strong>@ViewBag.TransactionId</strong>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(ViewBag.Amount))
                                {
                                    <div class="col-sm-6 mb-2">
                                        <small class="text-muted">Montant payé :</small><br>
                                        <strong class="text-success h5">@ViewBag.Amount @(ViewBag.Currency ?? "EUR")</strong>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(ViewBag.PayerId))
                                {
                                    <div class="col-sm-6 mb-2">
                                        <small class="text-muted">ID du payeur :</small><br>
                                        <strong>@ViewBag.PayerId</strong>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Prochaines étapes -->
                    <div class="alert alert-info border-0 mb-4">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-info-circle-fill text-info me-3 fs-4"></i>
                            <div class="text-start">
                                <h6 class="alert-heading">Prochaines étapes :</h6>
                                <ul class="mb-0 text-muted">
                                    <li>Vous recevrez un email de confirmation sous peu</li>
                                    <li>Votre commande sera traitée dans les 24h</li>
                                    <li>Vous recevrez les informations de suivi par email</li>
                                    <li>Livraison prévue sous 3-5 jours ouvrés</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Boutons d'action -->
                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg">
                            <i class="bi bi-house-fill me-2"></i>
                            Retour à l'accueil
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg">
                            <i class="bi bi-shop me-2"></i>
                            Continuer les achats
                        </a>
                    </div>
                </div>
            </div>

            <!-- Section support -->
            <div class="card mt-4 border-0">
                <div class="card-body text-center py-4">
                    <h6 class="text-muted mb-3">
                        <i class="bi bi-headset me-2"></i>
                        Besoin d'aide ?
                    </h6>
                    <p class="text-muted small mb-3">
                        Si vous avez des questions concernant votre commande, n'hésitez pas à nous contacter.
                    </p>
                    <div class="d-flex justify-content-center gap-3">
                        <a href="mailto:support@shopmaster.com" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-envelope me-1"></i>
                            Email
                        </a>
                        <a href="tel:+33123456789" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-telephone me-1"></i>
                            Téléphone
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 15px;
        overflow: hidden;
    }

    .btn {
        border-radius: 10px;
    }

    .alert {
        border-radius: 12px;
    }

    /* Animation de succès */
    @@keyframes bounceIn {
        0% {
            transform: scale(0.3);
            opacity: 0;
        }

        50% {
            transform: scale(1.05);
        }

        70% {
            transform: scale(0.9);
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    .bi-check-circle {
        animation: bounceIn 1s ease-out;
    }
</style>