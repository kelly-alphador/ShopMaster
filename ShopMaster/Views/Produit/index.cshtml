@using Microsoft.AspNetCore.Html
@model List<Produit>
@{
    ViewData["Title"] = "Liste des Produits";
    int pageIndex = (int)ViewData["PageIndex"]!;
    int totalPages = (int)ViewData["TotalPages"]!;
    int totalProducts = Model?.Count ?? 0;
    string Search = (string)ViewData["Search"]!;
    string column = (string)ViewData["colonne"]!;
    string orderBy = (string)ViewData["ordre"]!;

    HtmlString getArrow(string tableColumn)
    {
        if (tableColumn != column) return new HtmlString("");
        if (orderBy == "desc")
        {
            return new HtmlString("<i class='fas fa-chevron-down ms-1'></i>");
        }
        return new HtmlString("<i class='fas fa-chevron-up ms-1'></i>");
    }
}

<!-- SweetAlert2 CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/limonte-sweetalert2/11.10.1/sweetalert2.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/limonte-sweetalert2/11.10.1/sweetalert2.all.min.js"></script>

<div class="container-fluid">
    <!-- En-tête de la page -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="text-primary">
                <i class="fas fa-boxes me-2"></i>
                Liste des Produits
            </h2>
            <p class="text-muted">
                Total: @totalProducts produit(s) | Page @pageIndex sur @totalPages
            </p>
        </div>
        <div class="col-md-4 text-end">
            <a class="btn btn-success" asp-controller="Produit" asp-action="Create">
                <i class="fas fa-plus me-2"></i>
                Nouveau Produit
            </a>
        </div>
    </div>

    <!-- Filtres de recherche -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row">
                    <div class="col-md-4">
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-search"></i>
                            </span>
                            <input type="text" class="form-control" name="search"
                                   placeholder="Rechercher par nom ou marque..."
                                   value="@Search" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-outline-primary w-100">
                            <i class="fas fa-filter me-2"></i>Filtrer
                        </button>
                    </div>
                    <div class="col-md-2">
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary w-100">
                            <i class="fas fa-times me-2"></i>Reset
                        </a>
                    </div>
                </div>
                <input type="hidden" name="column" value="@column" />
                <input type="hidden" name="orderBy" value="@orderBy" />
                <input type="hidden" name="pageIndex" value="1" />
            </form>
        </div>
    </div>

   
    <!-- Table des produits -->
    <div class="card shadow">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th scope="col" style="cursor: pointer;" onclick="sortTable('Id')">
                                    <div class="d-flex align-items-center">
                                       ID @getArrow("Id")
                                    </div>
                                </th>
                                <th scope="col" style="cursor: pointer;" onclick="sortTable('Nom')">
                                    <div class="d-flex align-items-center">
                                      Nom @getArrow("Nom")
                                    </div>
                                </th>
                                <th scope="col" style="cursor: pointer;" onclick="sortTable('Marque')">
                                    <div class="d-flex align-items-center">
                                    Marque @getArrow("Marque")
                                    </div>
                                </th>
                                <th scope="col">
                                    <i class="fas fa-cubes me-2"></i>Quantité
                                </th>
                                <th scope="col" style="cursor: pointer;" onclick="sortTable('Prix')">
                                    <div class="d-flex align-items-center">
                                      Prix @getArrow("Prix")
                                    </div>
                                </th>
                                <th scope="col">
                                    <i class="fas fa-align-left me-2"></i>Description
                                </th>
                                <th scope="col">
                                    <i class="fas fa-image me-2"></i>Image
                                </th>
                                <th scope="col" style="cursor: pointer;" onclick="sortTable('DateCreation')">
                                    <div class="d-flex align-items-center">
                                     Date Création @getArrow("DateCreation")
                                    </div>
                                </th>
                                <th scope="col" class="text-center">
                                    Actions
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-light text-dark">#@product.Id</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                           
                                            <div>
                                                <h6 class="mb-0">@product.Nom</h6>
                                                <small class="text-muted">Produit #@product.Id</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@product.Marque</span>
                                    </td>
                                    <td>
                                        @if (product.qte > 10)
                                        {
                                            <span class="badge bg-success">@product.qte en stock</span>
                                        }
                                        else if (product.qte > 0)
                                        {
                                            <span class="badge bg-warning text-dark">@product.qte restant</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Rupture</span>
                                        }
                                    </td>
                                    <td>
                                        <strong class="text-success">@product.Prix.ToString("C")</strong>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(product.Description))
                                        {
                                            <div class="text-truncate" style="max-width: 200px;" title="@product.Description">
                                                @(product.Description.Length > 50 ? product.Description.Substring(0, 50) + "..." : product.Description)
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Aucune description</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                                        {
                                            <img src="~/product/@product.ImageUrl"
                                                 alt="@product.Nom"
                                                 class="img-thumbnail product-thumbnail"
                                                 style="width: 60px; height: 60px; object-fit: cover;"
                                                 onerror="this.src='/images/no-image.png';" />
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center justify-content-center bg-light rounded"
                                                 style="width: 60px; height: 60px;">
                                                <i class="fas fa-image text-muted"></i>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <div>
                                            @product.DateCreation.ToString("dd/MM/yyyy")
                                        </div>
                                        <small class="text-muted">
                                            @product.DateCreation.ToString("HH:mm")
                                        </small>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a class="btn btn-outline-primary btn-sm"
                                               asp-controller="Produit"
                                               asp-action="Details"
                                               asp-route-id="@product.Id"
                                               title="Voir les détails">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a class="btn btn-outline-warning btn-sm"
                                               asp-controller="Produit"
                                               asp-action="Edit"
                                               asp-route-id="@product.Id"
                                               title="Modifier">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button type="button"
                                                    class="btn btn-outline-danger btn-sm delete-btn"
                                                    data-id="@product.Id"
                                                    data-name="@product.Nom"
                                                    title="Supprimer">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-boxes fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">Aucun produit trouvé</h5>
                    <p class="text-muted">Commencez par ajouter votre premier produit.</p>
                    <a class="btn btn-primary" asp-controller="Produit" asp-action="Create">
                        <i class="fas fa-plus me-2"></i>Créer le premier produit
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <nav aria-label="Navigation des pages" class="mt-4">
            <ul class="pagination justify-content-center">
                <!-- Bouton Précédent -->
                @if (pageIndex > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-route-pageIndex="@(pageIndex - 1)"
                           asp-route-search="@Search"
                           asp-route-column="@column"
                           asp-route-orderBy="@orderBy">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <span class="page-link">
                            <i class="fas fa-chevron-left"></i>
                        </span>
                    </li>
                }

                <!-- Numéros de page -->
                @{
                    int startPage = Math.Max(1, pageIndex - 2);
                    int endPage = Math.Min(totalPages, pageIndex + 2);
                }

                @if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-route-pageIndex="1"
                           asp-route-search="@Search"
                           asp-route-column="@column"
                           asp-route-orderBy="@orderBy">1</a>
                    </li>
                    @if (startPage > 2)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == pageIndex ? "active" : "")">
                        <a class="page-link"
                           asp-route-pageIndex="@i"
                           asp-route-search="@Search"
                           asp-route-column="@column"
                           asp-route-orderBy="@orderBy">@i</a>
                    </li>
                }

                @if (endPage < totalPages)
                {
                    @if (endPage < totalPages - 1)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                    <li class="page-item">
                        <a class="page-link"
                           asp-route-pageIndex="@totalPages"
                           asp-route-search="@Search"
                           asp-route-column="@column"
                           asp-route-orderBy="@orderBy">@totalPages</a>
                    </li>
                }

                <!-- Bouton Suivant -->
                @if (pageIndex < totalPages)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-route-pageIndex="@(pageIndex + 1)"
                           asp-route-search="@Search"
                           asp-route-column="@column"
                           asp-route-orderBy="@orderBy">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <span class="page-link">
                            <i class="fas fa-chevron-right"></i>
                        </span>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

<!-- Styles CSS personnalisés -->
<style>
    .avatar-sm {
        height: 2rem;
        width: 2rem;
    }

    .avatar-title {
        align-items: center;
        display: flex;
        font-size: 0.875rem;
        font-weight: 500;
        height: 100%;
        justify-content: center;
        width: 100%;
    }

    .table th {
        border-top: none;
        font-weight: 600;
        letter-spacing: 0.5px;
        user-select: none;
    }

      

    .btn-group .btn {
        margin-right: 0.25rem;
    }

        .btn-group .btn:last-child {
            margin-right: 0;
        }

    .product-thumbnail {
        transition: transform 0.3s ease;
    }

        .product-thumbnail:hover {
            transform: scale(1.1);
            z-index: 10;
            position: relative;
        }

    .card {
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

        .card.shadow {
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }
</style>

@section Scripts {
    <script>
        // Affichage des messages avec SweetAlert2
        document.addEventListener('DOMContentLoaded', function() {
            // Messages de succès
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                        Swal.fire({
                            icon: 'success',
                            title: 'Succès !',
                            text: '@Html.Raw(TempData["SuccessMessage"])',
                            timer: 3000,
                            showConfirmButton: false,
                            toast: true,
                            position: 'top-end'
                        });
            </text>
        }

        @if (TempData["success"] != null)
        {
            <text>
                        Swal.fire({
                            icon: 'success',
                            title: 'Succès !',
                            text: '@Html.Raw(TempData["success"])',
                            timer: 3000,
                            showConfirmButton: false,
                            toast: true,
                            position: 'top-end'
                        });
            </text>
        }

            // Messages d'erreur
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
                        Swal.fire({
                            icon: 'error',
                            title: 'Erreur !',
                            text: '@Html.Raw(TempData["ErrorMessage"])',
                            timer: 4000,
                            showConfirmButton: true,
                            toast: true,
                            position: 'top-end'
                        });
            </text>
        }

        @if (TempData["error"] != null)
        {
            <text>
                        Swal.fire({
                            icon: 'error',
                            title: 'Erreur !',
                            text: '@Html.Raw(TempData["error"])',
                            timer: 4000,
                            showConfirmButton: true,
                            toast: true,
                            position: 'top-end'
                        });
            </text>
        }

            // Gestion de la suppression avec confirmation
            document.querySelectorAll('.delete-btn').forEach(function(button) {
                button.addEventListener('click', function(e) {
                    e.preventDefault();

                    const productId = this.getAttribute('data-id');
                    const productName = this.getAttribute('data-name');

                    Swal.fire({
                        title: 'Êtes-vous sûr ?',
                        html: `Vous allez supprimer le produit <strong>"${productName}"</strong>.<br>Cette action est irréversible !`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#3085d6',
                        confirmButtonText: '<i class="fas fa-trash me-2"></i>Oui, supprimer !',
                        cancelButtonText: '<i class="fas fa-times me-2"></i>Annuler',
                        reverseButtons: true,
                        customClass: {
                            confirmButton: 'btn btn-danger',
                            cancelButton: 'btn btn-secondary'
                        },
                        buttonsStyling: false
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // Afficher un loader pendant la suppression
                            Swal.fire({
                                title: 'Suppression en cours...',
                                html: '<i class="fas fa-spinner fa-spin me-2"></i>Veuillez patienter',
                                allowOutsideClick: false,
                                allowEscapeKey: false,
                                showConfirmButton: false,
                                didOpen: () => {
                                    Swal.showLoading();
                                }
                            });

                            // Rediriger vers l'action de suppression
                            window.location.href = `@Url.Action("Delete", "Produit")?id=${productId}`;
                        }
                    });
                });
            });
        });

        // Fonction de tri
        function sortTable(column) {
            let orderBy = "desc"
            let currentColumn = "@column";
            let currentOrder = "@orderBy";
            if (column === currentColumn) {
                if (currentOrder == "asc") orderBy = "desc";
                else orderBy = "asc";
            } else {
                orderBy = "asc";
            }

            const url = new URL(window.location);
            url.searchParams.set('search', '@Search');
            url.searchParams.set('column', column);
            url.searchParams.set('orderBy', orderBy);
            url.searchParams.set('pageIndex', '1');

            window.location.href = url.toString();
        }

        // Animation au survol des lignes du tableau
        document.querySelectorAll('.table tbody tr').forEach(row => {
            row.addEventListener('mouseenter', function() {
                this.style.transform = 'translateX(5px)';
                this.style.transition = 'transform 0.2s ease';
            });

            row.addEventListener('mouseleave', function() {
                this.style.transform = 'translateX(0)';
            });
        });
    </script>
}