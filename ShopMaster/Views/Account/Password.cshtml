@using ShopMaster.Models.DTO
@model PasswordDto
@{
}

<div class="d-flex justify-content-center align-items-center min-vh-100">
	<div class="password-card mx-auto rounded shadow-lg border-0 p-4" style="width: 400px; background: #fff;">
		<div class="text-center mb-4">
			<div class="password-icon mb-3">
				<i class="fas fa-lock" style="font-size: 2rem; color: #667eea;"></i>
			</div>
			<h3 class="text-dark mb-0 fw-semibold">Modifier le mot de passe</h3>
		</div>
		<hr style="border-color: #667eea; opacity: 0.2;" />

		@if (ViewBag.ErrorMessage != null)
		{
			<div class='alert alert-danger alert-dismissible fade show custom-alert' role='alert'>
				<i class="fas fa-exclamation-triangle me-2"></i>
				<strong>@ViewBag.ErrorMessage</strong>
				<button type='button' class='btn-close' data-bs-dismiss='alert' aria-label='Close'></button>
			</div>
		}
		else if (ViewBag.SuccessMessage != null)
		{
			<div class='alert alert-success alert-dismissible fade show custom-alert' role='alert'>
				<i class="fas fa-check-circle me-2"></i>
				<strong>@ViewBag.SuccessMessage</strong>
				<button type='button' class='btn-close' data-bs-dismiss='alert' aria-label='Close'></button>
			</div>
		}

		<form method="post" class="password-form">
			<div class="mb-3">
				<label class="form-label fw-semibold text-dark">Mot de passe actuel</label>
				<div class="input-group">
					<input class="form-control custom-input" type="password" asp-for="CurrentPassword" id="CurrentPassword" placeholder="Mot de passe actuel">
					<button class="btn btn-outline-secondary password-toggle" type="button" onclick="togglePassword('CurrentPassword')">
						<i class="fas fa-eye" id="CurrentPassword-eye"></i>
					</button>
				</div>
				<span asp-validation-for="CurrentPassword" class="text-danger small"></span>
			</div>

			<div class="mb-3">
				<label class="form-label fw-semibold text-dark">Nouveau mot de passe</label>
				<div class="input-group">
					<input class="form-control custom-input" type="password" asp-for="NewPassword" id="NewPassword" placeholder="Nouveau mot de passe">
					<button class="btn btn-outline-secondary password-toggle" type="button" onclick="togglePassword('NewPassword')">
						<i class="fas fa-eye" id="NewPassword-eye"></i>
					</button>
				</div>
				<span asp-validation-for="NewPassword" class="text-danger small"></span>
			</div>

			<div class="mb-4">
				<label class="form-label fw-semibold text-dark">Confirmer mot de passe</label>
				<div class="input-group">
					<input class="form-control custom-input" type="password" asp-for="ConfirmPassword" id="ConfirmPassword" placeholder="Confirmez le mot de passe">
					<button class="btn btn-outline-secondary password-toggle" type="button" onclick="togglePassword('ConfirmPassword')">
						<i class="fas fa-eye" id="ConfirmPassword-eye"></i>
					</button>
				</div>
				<span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
			</div>

			<div class="d-flex gap-2">
				<button type="submit" class="btn btn-primary w-50 custom-btn-primary">
					<i class="fas fa-save me-2"></i>Valider
				</button>
				<a class="btn btn-outline-secondary w-50 custom-btn-outline" asp-controller="Account" asp-action="Profile">
					<i class="fas fa-times me-2"></i>Annuler
				</a>
			</div>
		</form>
	</div>
</div>

<style>
	body {
		font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
		background: #f9f9f9; /* fond neutre clair */
	}

	.password-card {
		border-radius: 15px !important;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
		animation: slideUp 0.6s ease-out;
	}

		.password-card:hover {
			transform: translateY(-3px);
			box-shadow: 0 12px 25px rgba(0, 0, 0, 0.1) !important;
		}

	.custom-input {
		border: 1px solid #ddd;
		border-radius: 8px 0 0 8px;
		padding: 10px;
	}

		.custom-input:focus {
			border-color: #667eea;
			box-shadow: 0 0 0 0.1rem rgba(102, 126, 234, 0.25);
			background: #fff;
		}

	.password-toggle {
		border: 1px solid #ddd;
		border-left: none;
		border-radius: 0 8px 8px 0;
		background: #f8f9fa;
	}

		.password-toggle:hover {
			background: #e9ecef;
			color: #667eea;
		}

	.custom-btn-primary {
		background: #667eea;
		border: none;
		border-radius: 8px;
		padding: 10px;
		font-weight: 600;
		transition: all 0.3s ease;
	}

		.custom-btn-primary:hover {
			background: #5a67d8;
			transform: translateY(-1px);
		}

	.custom-btn-outline {
		border: 1px solid #6c757d;
		border-radius: 8px;
		padding: 10px;
		font-weight: 600;
		transition: all 0.3s ease;
		color: #6c757d;
	}

		.custom-btn-outline:hover {
			background: #6c757d;
			color: white;
		}

	.custom-alert {
		border-radius: 8px;
		border: none;
		padding: 12px 15px;
		margin-bottom: 20px;
	}

	.alert-success {
		background: #d4edda;
		color: #155724;
	}

	.alert-danger {
		background: #f8d7da;
		color: #721c24;
	}

	/* Animations */
	@@keyframes slideUp {
		from

	{
		opacity: 0;
		transform: translateY(50px);
	}

	to {
		opacity: 1;
		transform: translateY(0);
	}

	}
</style>

<script>
	function togglePassword(fieldName) {
		const passwordField = document.getElementById(fieldName);
		const eyeIcon = document.getElementById(fieldName + '-eye');

		if (passwordField.type === 'password') {
			passwordField.type = 'text';
			eyeIcon.classList.replace('fa-eye', 'fa-eye-slash');
		} else {
			passwordField.type = 'password';
			eyeIcon.classList.replace('fa-eye-slash', 'fa-eye');
		}
	}

	document.addEventListener('DOMContentLoaded', function () {
		// Auto-dismiss alerts après 4 secondes
		document.querySelectorAll('.alert').forEach(alert => {
			setTimeout(() => {
				let closeBtn = alert.querySelector('.btn-close');
				if (closeBtn) closeBtn.click();
			}, 4000);
		});
	});
</script>

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
