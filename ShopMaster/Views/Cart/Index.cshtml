@using ShopMaster.Models
@{
    ViewData["Title"] = "Panier";
    List<LigneCommande> cartItems = ViewBag.CartItems;
    decimal subtotal = ViewBag.Subtotal;
    decimal shippingFee = ViewBag.ShippingFee;
    decimal total = ViewBag.Total;
}

<div class="container my-4">
    <h2 class="mb-4">
        <i class="bi bi-cart4 text-danger"></i> Mon Panier
    </h2>

    @if (cartItems.Count == 0)
    {
        <div class="alert alert-info text-center py-5">
            <h4>Votre panier est vide</h4>
            <p>Découvrez nos produits et ajoutez-les à votre panier</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-shop"></i> Continuer les achats
            </a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-body">
                        @foreach (var item in cartItems)
                        {
                            <div class="row align-items-center border-bottom py-3">
                                <div class="col-md-2">
                                    @if (!string.IsNullOrEmpty(item.Produit.ImageUrl))
                                    {
                                        <img src="~/product/@item.Produit.ImageUrl"
                                             class="img-fluid rounded"
                                             style="max-height: 80px;"
                                             alt="@item.Produit.Nom">
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                             style="height: 80px; width: 80px;">
                                            <i class="bi bi-image text-muted"></i>
                                        </div>
                                    }
                                </div>
                                <div class="col-md-4">
                                    <h6 class="mb-1">@item.Produit.Nom</h6>
                                    <small class="text-muted">@item.Produit.Marque</small>
                                </div>
                                <div class="col-md-2 text-center">
                                    <strong>@item.PrixUnitaire.ToString("0.00") €</strong>
                                </div>
                                <div class="col-md-3">
                                    <div class="input-group input-group-sm">
                                        <button type="button" class="btn btn-outline-secondary"
                                                onclick="decrease(@item.Produit.Id)"
                                        @(item.Quantite <= 1 ? "disabled" : "")>
                                            <i class="bi bi-dash"></i>
                                        </button>
                                        <input type="text" class="form-control text-center"
                                               value="@item.Quantite" readonly>
                                        <button type="button" class="btn btn-outline-secondary"
                                                onclick="increase(@item.Produit.Id)">
                                            <i class="bi bi-plus"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="col-md-1 text-center">
                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                            onclick="if(confirm('Êtes-vous sûr de vouloir supprimer cet article ?')) remove(@item.Produit.Id)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-3 d-flex justify-content-between">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-left"></i> Continuer les achats
                    </a>

                    <form asp-controller="Cart" asp-action="Clear" method="post" style="display: inline;">
                        <button type="submit" class="btn btn-outline-danger"
                                onclick="return confirm('Êtes-vous sûr de vouloir vider complètement votre panier ?')">
                            <i class="bi bi-trash3"></i> Vider le panier
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Résumé de la commande</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <span>Sous-total:</span>
                            <span>@subtotal.ToString("0.00") €</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Frais de port:</span>
                            <span>@shippingFee.ToString("0.00") €</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between fw-bold">
                            <span>Total:</span>
                            <span class="text-primary">@total.ToString("0.00") €</span>
                        </div>
                      
                        <div class="d-grid gap-2 mt-4">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <a asp-controller="Payment" asp-action="Index" class="btn btn-primary btn-lg w-100">
                                    <i class="bi bi-credit-card"></i> Passer la commande
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login"
                                   asp-route-returnUrl="@Url.Action("Index", "Cart")"
                                   class="btn btn-primary btn-lg">
                                    <i class="bi bi-person-check"></i> Se connecter pour commander
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>