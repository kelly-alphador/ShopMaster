@model ShopMaster.Models.Commande
@{
    ViewData["Title"] = "Commande confirmée";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-success text-white text-center">
                    <h3><i class="bi bi-check-circle"></i> Commande confirmée !</h3>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <h4>Merci pour votre commande</h4>
                        <p class="text-muted">Votre paiement a été traité avec succès</p>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <strong>Numéro de commande :</strong><br>
                            <span class="text-primary">#@Model.Id</span>
                        </div>
                        <div class="col-md-6">
                            <strong>Date de commande :</strong><br>
                            @Model.DateCreation.ToString("dd/MM/yyyy à HH:mm")
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <strong>Statut :</strong><br>
                            <span class="badge bg-success">@Model.StatutCommande</span>
                        </div>
                        <div class="col-md-6">
                            <strong>Total payé :</strong><br>
                            <span class="h5 text-success">@Model.Total.ToString("0.00") €</span>
                        </div>
                    </div>

                    <h5>Détail de la commande</h5>
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Produit</th>
                                    <th>Prix unitaire</th>
                                    <th>Quantité</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.LignesCommande)
                                {
                                    <tr>
                                        <td>
                                            <strong>@item.Produit.Nom</strong><br>
                                            <small class="text-muted">@item.Produit.Marque</small>
                                        </td>
                                        <td>@item.PrixUnitaire.ToString("0.00") €</td>
                                        <td>@item.Quantite</td>
                                        <td>@((item.PrixUnitaire * item.Quantite).ToString("0.00")) €</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i>
                        <strong>Que se passe-t-il maintenant ?</strong><br>
                        • Un email de confirmation vous a été envoyé<br>
                        • Votre commande sera préparée dans les 24h<br>
                        • Vous recevrez un email de suivi de livraison
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                            <i class="bi bi-house"></i> Retour à l'accueil
                        </a>
                        <a href="#" onclick="window.print()" class="btn btn-outline-secondary">
                            <i class="bi bi-printer"></i> Imprimer cette page
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>