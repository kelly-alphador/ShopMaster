@model List<ApplicationUser>
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Liste des Utilisateurs";
    int currentPage = ViewBag.PageIndex ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalUsers = ViewBag.TotalUsers ?? 0;
}

<div class="container-fluid">
    <!-- En-tête de la page -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="text-primary">
                <i class="fas fa-users me-2"></i>
                Liste des Utilisateurs
            </h2>
            <p class="text-muted">
                Total: @totalUsers utilisateur(s) | Page @currentPage sur @totalPages
            </p>
        </div>
        <div class="col-md-4 text-end">
            <a class="btn btn-success" asp-controller="Users" asp-action="Create">
                <i class="fas fa-plus me-2"></i>
                Nouvel Utilisateur
            </a>
        </div>
    </div>

    <!-- Filtres de recherche (optionnel) -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row">
                    <div class="col-md-3">
                        <input type="text" class="form-control" name="searchTerm"
                               placeholder="Rechercher par nom ou email..."
                               value="@ViewBag.SearchTerm" />
                    </div>
                    <div class="col-md-2">
                        <select class="form-select" name="roleFilter">
                            <option value="">Tous les rôles</option>
                            <option value="admin">Administrateur</option>
                            <option value="seller">Vendeur</option>
                            <option value="client">Client</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-outline-primary">
                            <i class="fas fa-search me-2"></i>Filtrer
                        </button>
                    </div>
                </div>
                <input type="hidden" name="pageIndex" value="1" />
            </form>
        </div>
    </div>

    <!-- Table des utilisateurs -->
    <div class="card shadow">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th scope="col">
                                    <i class="fas fa-user me-2"></i>Nom Complet
                                </th>
                                <th scope="col">
                                    <i class="fas fa-envelope me-2"></i>Email
                                </th>
                                <th scope="col">
                                    <i class="fas fa-phone me-2"></i>Téléphone
                                </th>
                                <th scope="col">
                                    <i class="fas fa-user-tag me-2"></i>Rôle
                                </th>
                                <th scope="col">
                                    <i class="fas fa-calendar me-2"></i>Date de Création
                                </th>
                                <th scope="col" class="text-center">
                                    <i class="fas fa-cogs me-2"></i>Actions
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm me-3">
                                                <div class="avatar-title rounded-circle bg-primary text-white">
                                                    @(user.UserName?.FirstOrDefault().ToString().ToUpper() ?? "U")
                                                </div>
                                            </div>
                                            <div>
                                                <h6 class="mb-0">@(user.UserName)</h6>
                                                @if (!string.IsNullOrEmpty(user.UserName))
                                                {
                                                    <small class="text-muted">@@@user.UserName</small>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <a href="mailto:@user.Email" class="text-decoration-none">
                                            @user.Email
                                        </a>
                                        @if (user.EmailConfirmed)
                                        {
                                            <i class="fas fa-check-circle text-success ms-2" title="Email vérifié"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-exclamation-circle text-warning ms-2" title="Email non vérifié"></i>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(user.PhoneNumber))
                                        {
                                            <a href="tel:@user.PhoneNumber" class="text-decoration-none">
                                                @user.PhoneNumber
                                            </a>
                                            @if (user.PhoneNumberConfirmed)
                                            {
                                                <i class="fas fa-check-circle text-success ms-2" title="Téléphone vérifié"></i>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">Non renseigné</span>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            var roles = await UserManager.GetRolesAsync(user);
                                            var rolesStr = string.Join(", ", roles);
                                            string badgeClass = "bg-secondary";
                                            string icon = "fas fa-user";

                                            if (roles.Contains("admin"))
                                            {
                                                badgeClass = "bg-danger";
                                                icon = "fas fa-crown";
                                            }
                                            else if (roles.Contains("seller"))
                                            {
                                                badgeClass = "bg-warning text-dark";
                                                icon = "fas fa-store";
                                            }
                                            else if (roles.Contains("client"))
                                            {
                                                badgeClass = "bg-info text-dark";
                                                icon = "fas fa-shopping-cart";
                                            }
                                        }
                                        @if (roles.Any())
                                        {
                                            <span class="badge rounded-pill @badgeClass">
                                                <i class="@icon me-1"></i>@rolesStr
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-light text-dark">
                                                <i class="fas fa-user me-1"></i>Aucun rôle
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div>
                                            @user.DateCreation.ToString("dd/MM/yyyy")
                                        </div>
                                        <small class="text-muted">
                                            @user.DateCreation.ToString("HH:mm")
                                        </small>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a class="btn btn-outline-primary btn-sm"
                                               asp-controller="Users"
                                               asp-action="Details"
                                               asp-route-id="@user.Id"
                                               title="Voir les détails">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a class="btn btn-outline-warning btn-sm"
                                               asp-controller="Users"
                                               asp-action="Edit"
                                               asp-route-id="@user.Id"
                                               title="Modifier">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            @if (!roles.Contains("admin") || (await UserManager.GetUsersInRoleAsync("admin")).Count > 1)
                                            {
                                                <button type="button"
                                                        class="btn btn-outline-danger btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal"
                                                        data-user-id="@user.Id"
                                                        data-user-name="@(user.UserName )"
                                                        title="Supprimer">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-users fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">Aucun utilisateur trouvé</h5>
                    <p class="text-muted">Il n'y a actuellement aucun utilisateur à afficher.</p>
                </div>
            }
        </div>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <nav aria-label="Navigation des pages" class="mt-4">
            <ul class="pagination justify-content-center">
                <!-- Bouton Précédent -->
                @if (currentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-route-pageIndex="@(currentPage - 1)" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-roleFilter="@ViewBag.RoleFilter">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <span class="page-link">
                            <i class="fas fa-chevron-left"></i>
                        </span>
                    </li>
                }

                <!-- Numéros de page -->
                @{
                    int startPage = Math.Max(1, currentPage - 2);
                    int endPage = Math.Min(totalPages, currentPage + 2);
                }

                @if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-route-pageIndex="1" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-roleFilter="@ViewBag.RoleFilter">1</a>
                    </li>
                    @if (startPage > 2)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-route-pageIndex="@i" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-roleFilter="@ViewBag.RoleFilter">@i</a>
                    </li>
                }

                @if (endPage < totalPages)
                {
                    @if (endPage < totalPages - 1)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                    <li class="page-item">
                        <a class="page-link" asp-route-pageIndex="@totalPages" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-roleFilter="@ViewBag.RoleFilter">@totalPages</a>
                    </li>
                }

                <!-- Bouton Suivant -->
                @if (currentPage < totalPages)
                {
                    <li class="page-item">
                        <a class="page-link" asp-route-pageIndex="@(currentPage + 1)" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-roleFilter="@ViewBag.RoleFilter">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <span class="page-link">
                            <i class="fas fa-chevron-right"></i>
                        </span>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

<!-- Modal de confirmation de suppression -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                    Confirmer la suppression
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <p>Êtes-vous sûr de vouloir supprimer l'utilisateur <strong id="userToDelete"></strong> ?</p>
                <p class="text-danger">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    Cette action est irréversible.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <form id="deleteForm" method="post" style="display: inline;">
                    <input type="hidden" name="id" id="userIdToDelete" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-2"></i>Supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Styles CSS personnalisés -->
<style>
    .avatar-sm {
        height: 2rem;
        width: 2rem;
    }

    .avatar-title {
        align-items: center;
        display: flex;
        font-size: 0.875rem;
        font-weight: 500;
        height: 100%;
        justify-content: center;
        width: 100%;
    }

    .table th {
        border-top: none;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .btn-group .btn {
        margin-right: 0.25rem;
    }

    .btn-group .btn:last-child {
        margin-right: 0;
    }
</style>

<!-- JavaScript pour la modal de suppression -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const deleteModal = document.getElementById('deleteModal');
        if (deleteModal) {
            deleteModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const userId = button.getAttribute('data-user-id');
                const userName = button.getAttribute('data-user-name');

                const userToDeleteElement = deleteModal.querySelector('#userToDelete');
                const userIdToDeleteElement = deleteModal.querySelector('#userIdToDelete');
                const deleteForm = deleteModal.querySelector('#deleteForm');

                userToDeleteElement.textContent = userName;
                userIdToDeleteElement.value = userId;
                deleteForm.action = '@Url.Action("Delete", "Users")';
            });
        }
    });
</script>