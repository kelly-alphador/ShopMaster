@using Microsoft.AspNetCore.Identity
@model ApplicationUser

@{
    ViewData["Title"] = "Détails de l'utilisateur";
    var roles = ViewBag.UserRoles as List<string> ?? new List<string>();
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0"><i class="fas fa-user-circle me-2"></i>Détails de l'utilisateur</h4>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-4 text-center">
                            <div class="avatar-circle bg-light-blue text-white mb-3">
                                <i class="fas fa-user fa-2x"></i>
                            </div>
                            <h5 class="text-primary">@Model.UserName</h5>
                            <div class="mt-2">
                                @foreach (var role in roles)
                                {
                                    <span class="badge bg-primary me-1">@role</span>
                                }
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="detail-item">
                                        <label class="text-primary fw-bold">Nom d'utilisateur</label>
                                        <p>@Model.UserName</p>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="detail-item">
                                        <label class="text-primary fw-bold">Email</label>
                                        <p>@Model.Email</p>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="detail-item">
                                        <label class="text-primary fw-bold">ID</label>
                                        <p class="text-muted small">@Model.Id</p>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="detail-item">
                                        <label class="text-primary fw-bold">Email confirmé</label>
                                        <p>
                                            @if (Model.EmailConfirmed)
                                            {
                                                <span class="badge bg-success">Oui</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Non</span>
                                            }
                                        </p>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="detail-item">
                                        <label class="text-primary fw-bold">Téléphone</label>
                                        <p>@(Model.PhoneNumber ?? "Non renseigné")</p>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="detail-item">
                                        <label class="text-primary fw-bold">Verrouillage</label>
                                        <p>
                                            @if (Model.LockoutEnd.HasValue && Model.LockoutEnd > DateTime.Now)
                                            {
                                                <span class="badge bg-danger">Compte verrouillé</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Compte actif</span>
                                            }
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-12">
                            <h5 class="text-primary border-bottom pb-2">Rôles attribués</h5>
                            @if (roles.Any())
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var role in roles)
                                    {
                                        <span class="badge bg-primary py-2 px-3">@role</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">Aucun rôle attribué à cet utilisateur.</p>
                            }
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light py-3">
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-primary">
                            <i class="fas fa-arrow-left me-1"></i> Retour à la liste
                        </a>
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary me-2">
                                <i class="fas fa-edit me-1"></i> Modifier
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                                <i class="fas fa-trash-alt me-1"></i> Supprimer
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

    <style>
        :root {
            --primary-blue: #1976D2;
            --light-blue: #2196F3;
            --background: #F8FBFF;
        }

        body {
            background-color: var(--background);
        }

        .card {
            border-radius: 10px;
            overflow: hidden;
        }

        .avatar-circle {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto;
            background-color: var(--light-blue);
        }

        .detail-item {
            margin-bottom: 1.2rem;
        }

            .detail-item label {
                font-size: 0.9rem;
                margin-bottom: 0.3rem;
                display: block;
            }

            .detail-item p {
                margin: 0;
                padding: 0.5rem 0;
                font-size: 1rem;
            }

        .bg-light-blue {
            background-color: var(--light-blue);
        }

        .btn-primary {
            background-color: var(--primary-blue);
            border-color: var(--primary-blue);
        }

            .btn-primary:hover {
                background-color: #1565C0;
                border-color: #1565C0;
            }

        .text-primary {
            color: var(--primary-blue) !important;
        }
    </style>



    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
